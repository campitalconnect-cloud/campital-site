{
  "name": "campital",
  "version": "1.0.0",
  "description": "Campital - Institutional Campus Venture Network",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"node server/src/index.js\" \"vite\"",
    "dev:client": "vite",
    "server": "node server/src/index.js",
    "server:dev": "node --watch server/src/index.js",
    "postinstall": "prisma generate --schema=server/prisma/schema.prisma",
    "build": "prisma generate --schema=server/prisma/schema.prisma && vite build",
    "preview": "vite preview",
    "prisma:push": "cd server && npx prisma db push",
    "prisma:generate": "cd server && npx prisma generate"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "framer-motion": "^13.4.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "resend": "^6.38.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.7",
    "prisma": "^6.19.3",
    "vite": "^6.1.0"
  }
}

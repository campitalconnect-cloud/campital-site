# ========================================================
# CAMPITAL CRM BACKEND CONFIGURATION
# ========================================================

# Server Port
PORT=5001
NODE_ENV=development

# Neon Database Connection String (PostgreSQL)
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Admin Authentication
JWT_SECRET="campital_super_secure_jwt_secret_change_in_production_2026"

# Frontend Application Origin (for CORS)
CLIENT_ORIGIN="http://localhost:3000"

# Central Recipient & Notification Email
CENTRAL_TEAM_EMAIL="team@campital.in"

# Email Provider Configuration (SMTP or Resend)
# Option 1: Standard SMTP (Gmail, Brevo, SendGrid, Amazon SES, etc.)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="resend"
SMTP_PASS="YOUR_SMTP_OR_RESEND_KEY"
EMAIL_FROM="Campital Deal Desk <team@campital.in>"

# Option 2: Resend API Key (if using Resend REST API)
# RESEND_API_KEY="re_1234567890"

# Max File Size for Pitch Deck Uploads (in Bytes - default 25MB)
MAX_FILE_SIZE_BYTES=26214400
